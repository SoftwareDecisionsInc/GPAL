  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Force the System.ValueTuple 4.0.5.0 DLL into the copy-local set. RAR treats it as an
       in-box facade and refuses to copy it, but System.Text.Json pulls it transitively and the
       auto-generated binding redirect hard-demands assembly 4.0.5.0 (the in-box facade is only
       4.0.0.0). Injecting it here lands the DLL in this project's output and flows it through
       ProjectReference into every consuming test exe, satisfying the redirect at runtime. -->
  <Target Name="AddValueTupleCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="$(PkgSystem_ValueTuple)\lib\net462\System.ValueTuple.dll" />
    </ItemGroup>
  </Target>
