  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="Nager.PublicSuffix" Version="3.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="Selenium.Support" Version="4.51.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.51.0" />
    <PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
    <!-- ValueTuple is in-box on net48 (mscorlib), so this package suppresses copy-local,
         but System.Text.Json pulls it transitively and the auto-generated binding redirect
         demands assembly 4.0.5.0, which nothing on disk provides (in-box facade is 4.0.0.0).
         GeneratePathProperty exposes $(PkgSystem_ValueTuple) so the AddValueTupleCopyLocal
         target below can land the 4.0.5.0 DLL in the output folder and satisfy the redirect. -->
    <PackageReference Include="System.ValueTuple" GeneratePathProperty="true" Version="4.6.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Force the System.ValueTuple 4.0.5.0 DLL into the copy-local set. RAR treats it as an
       in-box facade and refuses to copy it, but System.Text.Json pulls it transitively and the
       auto-generated binding redirect hard-demands assembly 4.0.5.0 (the in-box facade is only
       4.0.0.0). Injecting it here lands the DLL in this project's output and flows it through
       ProjectReference into every consuming test exe, satisfying the redirect at runtime. -->
  <Target Name="AddValueTupleCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="$(PkgSystem_ValueTuple)\lib\net462\System.ValueTuple.dll" />
    </ItemGroup>
  </Target>

  <!-- programs that reference GPAL do not copy the DLL above out of GPAL's bin on their own;
       as a copied item it lands beside every one of them, as it did before. It is added in a target,
       after references resolve, because a DLL listed as a project item would become what GPAL compiles against -->
  <Target Name="CopyValueTupleToPrograms" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="$(PkgSystem_ValueTuple)\lib\net462\System.ValueTuple.dll" Link="System.ValueTuple.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
